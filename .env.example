# AVZCloud Central Manager - plantilla de variables. Copiar a `.env` (permisos 600) en el servidor.
# NUNCA escribir valores reales aqui ni subir `.env` a git. Comprobar con:
#   docker compose -p <proyecto> --env-file .env -f deploy/docker-compose.yml --profile tools run --rm cli check-env
# Lo lee `docker compose` (interpolacion en deploy/docker-compose.yml): el compose no contiene valores.
# Instalacion limpia: `deploy/instalar.sh` crea el `.env` desde esta plantilla y genera los secretos.
# Tabla completa de variables: deploy/INSTALACION-NUEVO-SERVIDOR.md.

# ------------------------------------------------------------------ Proyecto y puertos locales
# Nombre del proyecto Compose (prefijo de contenedores, red y volumen). instalar.sh lo guarda aqui.
# Cambiarlo permite un segundo stack de prueba en el mismo servidor (con otros puertos y otra subred).
COMPOSE_PROJECT_NAME=mikrotik-manager
# Puertos publicados en el HOST. Por defecto solo en loopback (127.0.0.1): el proxy de entrada con TLS
# es la unica entrada. No poner 0.0.0.0 salvo que otro firewall lo proteja.
API_BIND=127.0.0.1
API_PORT=8090
WEB_BIND=127.0.0.1
WEB_PORT=8091

# ------------------------------------------------------------------ Base de datos
# El host de la BD lo fija el compose (nombre del servicio `mikrotik-db`): no es una variable de este archivo.
# OBLIGATORIAS. En una instalacion limpia instalar.sh pone `avzcloud` en ambas; con un volumen
# migrado deben coincidir con las del volumen existente.
POSTGRES_DB=
POSTGRES_USER=
# OBLIGATORIA. Generar con: openssl rand -hex 24   (solo hex: seguro para compose y SQL).
# OJO: PostgreSQL solo aplica este valor al CREAR el volumen. Con un volumen existente hay que
# cambiarla tambien en la base (ALTER ROLE), ver deploy/DEPLOY.md paso "Rotar contrasena de la BD".
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ API: secretos
# OBLIGATORIA. Firma de los tokens de sesion (JWT). Minimo 32 caracteres; la API no arranca si es corta.
# Generar en el servidor: openssl rand -hex 32.  Cambiarla cierra todas las sesiones.
SECRET_KEY=
# OBLIGATORIA. Clave Fernet que cifra las claves privadas WireGuard y las contrasenas de API de los
# routers guardadas en la BD. Si se pierde NO se pueden recuperar: guardar copia en el gestor de
# secretos de AVZ. Generar: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=
# Duracion de la sesion en horas (por defecto 12).
TOKEN_HOURS=12
# Origenes permitidos por CORS, separados por coma. VACIO = solo mismo origen (recomendado: la UI
# y la API comparten dominio detras del proxy).
CORS_ORIGINS=

# IPs de los proxys en las que la API confia para leer X-Forwarded-For (IP real del cliente en el
# limitador de login y en la auditoria). Debe ser la IP con la que el contenedor ve al proxy de entrada:
# la pasarela de edge-net. Si se deja VACIA/comentada, el compose usa AVZ_EDGE_GATEWAY (recomendado).
# NUNCA "*".
#FORWARDED_ALLOW_IPS=172.29.91.1
# Subred y pasarela de la red edge-net; cambiar solo si chocan con otra red del servidor
# (instalar.sh --subred las calcula y las guarda aqui). La pasarela es la primera IP de la subred.
AVZ_EDGE_SUBNET=172.29.91.0/24
AVZ_EDGE_GATEWAY=172.29.91.1
# SOLO para migrar el srv-2 con docker-compose.srv2.yml: nombre real del volumen existente de PostgreSQL
# (verificar con `docker volume ls`); alli se declara `external`. En una instalacion limpia no se usa.
PG_VOLUME_NAME=mikrotik-manager_postgres_data
# Version de los assets de la interfaz (cache largo). Cambiarla en cada despliegue (p. ej. fecha).
ASSET_VERSION=1

# ------------------------------------------------------------------ Hub WireGuard (MikroTik cloud, red privada)
# OBLIGATORIAS para aprovisionar, VPN y monitoreo.
HUB_HOST=10.10.10.3
HUB_API_PORT=8728
# Usuario de API del hub con permisos minimos (sin `policy`) y su contrasena.
HUB_API_USER=
HUB_API_PASSWORD=
# Interfaz WireGuard DEL PROYECTO en el hub (la de los routers/VPN). Jamas la de la Notaria (wg1).
HUB_WG_INTERFACE=
# Nombre DNS o IP publica del hub que reciben los clientes WireGuard, y su puerto UDP.
HUB_PUBLIC_ENDPOINT=
HUB_PUBLIC_PORT=51820

# ------------------------------------------------------------------ Routers cliente (respaldo)
# Solo para adoptar equipos YA desplegados que no tengan usuario de API propio. Los routers nuevos
# reciben un usuario `avz-api` con contrasena aleatoria cifrada en la BD. Dejar vacio si no se usa.
EDGE_API_USER=
EDGE_API_PASSWORD=

# ------------------------------------------------------------------ Monitoreo y alertas (valores por defecto)
# Todas opcionales: sin definir se usan estos valores. Los numericos se limitan a un rango seguro.
# 0/false/no desactiva la tarea periodica de monitoreo.
MONITOR_ENABLED=1
# Segundos entre ciclos de comprobacion (10-3600).
MONITOR_INTERVAL_SECONDS=60
# Un handshake WireGuard mas reciente que esto = equipo en linea (30-3600).
MONITOR_ONLINE_SECONDS=180
# Minutos sostenidos fuera de linea antes de enviar la alerta de caida (1-1440).
MONITOR_ALERT_MINUTES=5
# Dias que se conserva el historial de metricas_equipo (1-3650).
MONITOR_RETENTION_DAYS=90
# Intervalo minimo entre muestras de un equipo sin cambio de estado (10-3600).
MONITOR_SAMPLE_SECONDS=300
# Senal de vida rapida: bytes recibidos crecieron dentro de esta ventana (0 la desactiva; 0-3600).
MONITOR_RX_WINDOW_SECONDS=90
# Una muestra previa de trafico mas vieja que esto no sirve para comparar (30-86400).
MONITOR_RX_STALE_SECONDS=300
# Copia opcional de TODAS las alertas, correos separados por coma. El SMTP se configura en la BD
# (tabla configuracion_smtp), no aqui.
ALERT_EXTRA_RECIPIENTS=

# ------------------------------------------------------------------ NO definir en este archivo
# ADMIN_BOOTSTRAP_PASSWORD: contrasena inicial del superadmin. Solo la lee `python -m app.cli
# set-admin-password`. Se pasa en el momento del comando (ver deploy/DEPLOY.md) y no se guarda en
# disco; el servicio de la API ni siquiera la recibe.
